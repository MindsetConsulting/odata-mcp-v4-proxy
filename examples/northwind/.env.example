# Northwind V4 demo — copy to .env or export in your shell

# Base URL of the public Northwind V4 service
NORTHWIND_V4_BASE_URL=https://services.odata.org

# Anonymous access — no OAuth or basic auth required
NORTHWIND_V4_AUTH=none

# Where to load the api config from
API_CONFIG_FILE=examples/northwind/northwind-config.json

# MCP transport — http for Inspector + desktop apps, stdio for direct CLI
MCP_TRANSPORT=http
PORT=4004
LOG_LEVEL=info
