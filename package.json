{
  "name": "odata-mcp-v4-proxy",
  "version": "0.1.0",
  "description": "Config-driven MCP proxy that exposes OData V4 APIs as MCP tools. V4 fork of odata-mcp-proxy.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "odata-mcp-v4-proxy": "dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "start:stdio": "MCP_TRANSPORT=stdio node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:northwind": "API_CONFIG_FILE=examples/northwind/northwind-config.json MCP_TRANSPORT=http tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector",
    "inspect:http": "npx @modelcontextprotocol/inspector --cli http://localhost:4004/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.1",
    "@sap-cloud-sdk/connectivity": "^4.0.0",
    "@sap-cloud-sdk/http-client": "^4.0.0",
    "@sap/xsenv": "^4.0.0",
    "@sap/xssec": "^3.6.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
